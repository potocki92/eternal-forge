# Eternal Forge — environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and must never be
# committed (docs/SECURITY.md — "Secrets").
#
# Variables are validated at process start by `@eternal-forge/config`; an invalid
# or missing value fails the boot rather than surfacing later as a runtime error.

# --- Shared ------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# --- PostgreSQL --------------------------------------------------------------
# Pooled connection used at runtime.
DATABASE_URL=postgresql://forge:forge@localhost:5432/eternal_forge
# Direct connection used by Prisma Migrate. On Supabase this is the non-pooled
# endpoint; DDL cannot run through the transaction pooler. Locally both are the
# same server.
DIRECT_URL=postgresql://forge:forge@localhost:5432/eternal_forge

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- API (apps/api) ----------------------------------------------------------
API_PORT=3001
# Comma-separated list of browser origins allowed to call the API.
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Release identifier reported by the health endpoints. CI sets this to the build
# revision; leave unset locally.
# SERVICE_VERSION=

# --- Worker (apps/worker) ----------------------------------------------------
WORKER_CONCURRENCY=1

# --- Web (apps/web) ----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Supabase Auth ------------------------------------------------------------
# The API verifies Supabase access tokens locally (ADR-016). It needs to know
# which project issues them — not a privileged key.
#
# Local development without a Supabase project: run the Auth test double
#   pnpm --filter @eternal-forge/web run auth:stub
# which listens on http://127.0.0.1:54329. The web build defaults to it.
# With a real project, use https://<project-ref>.supabase.co here and set the
# two NEXT_PUBLIC_SUPABASE_* values below.
SUPABASE_URL=http://127.0.0.1:54329
# Only for projects that still sign tokens with the legacy shared HS256 secret.
# Leave unset otherwise: HS256 tokens are then refused outright.
# SUPABASE_JWT_SECRET=replace-me-with-at-least-32-characters
# Expected `aud` claim; Supabase uses `authenticated`.
# AUTH_JWT_AUDIENCE=authenticated

# Public, browser-safe Supabase configuration (the anon/publishable key is
# designed to ship to browsers). Defaults point at the local test double.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# The service-role key bypasses Row Level Security. No Phase 2 process reads
# it. If a future server process needs it, it exists only in that server's
# environment — never in a browser bundle, never in apps/web.
# SUPABASE_SERVICE_ROLE_KEY=replace-me
