{
  "name": "eternal-forge",
  "version": "0.0.0",
  "private": true,
  "description": "Eternal Forge — browser-first idle action RPG (modular monolith, server-authoritative).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @eternal-forge/database run db:generate",
    "db:migrate": "pnpm --filter @eternal-forge/database run db:migrate",
    "db:deploy": "pnpm --filter @eternal-forge/database run db:deploy",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@eternal-forge/eslint-config": "workspace:*",
    "@eternal-forge/typescript-config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
