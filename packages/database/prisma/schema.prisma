// Eternal Forge — Prisma schema
//
// PostgreSQL is the persistent source of truth (docs/DATABASE.md). Tables are
// introduced by the phase that needs them. Phase 2 adds identity-linked player
// data only: `profiles` and `characters` (ADR-017). Phase 3 adds progression
// to `characters` and the combat record `combat_runs` (ADR-019). Phase 4 adds
// the stage mode for stage selection and farming (ADR-021), and offline
// progression: the offline seed on `characters` and the claim record
// `offline_runs` (ADR-023).
//
// Domain entities are NOT Prisma models. Prisma models are persistence models,
// mapped to domain entities by repository implementations (CLAUDE.md —
// "Persistence").

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = []
}

// Connection strings live in `prisma.config.ts` (Migrate/Introspect) and are
// supplied to the runtime client through a driver adapter — see
// `src/prisma/prisma-client.ts`.
datasource db {
  provider = "postgresql"
}

// A player's application profile, linked one-to-one to a Supabase Auth user.
//
// `id` is our own identifier and the one every other table references. The
// Supabase Auth UUID appears in this table only, so authentication identity
// stays replaceable and is never spread across the domain (ADR-017).
//
// Constraints that Prisma cannot express (CHECKs, Row Level Security) live in
// the migration SQL.
model Profile {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// `auth.users.id` of the owning Supabase user. Unique: one profile per identity.
  authUserId  String      @unique(map: "profiles_auth_user_id_key") @map("auth_user_id") @db.Uuid
  displayName String      @map("display_name") @db.VarChar(24)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  characters  Character[]

  @@map("profiles")
}

// A playable character owned by a profile.
//
// Only the *source* of state is stored. Combat stats, the experience needed for
// the next level and the enemy on the current stage are derived by the
// versioned Game Core rules and are never persisted (ADR-017, ADR-019).
//
// HugeNumber quantities use the two-column form of ADR-013: `<name>_coef`
// (18-digit coefficient, or 0) and `<name>_exp` (scientific exponent, or the
// zero sentinel -2147483648). The migration constrains them to normalised,
// non-negative whole amounts.
//
// `slot` makes "the main character" a data property instead of a schema
// limit: Phase 2 provisions slot 1, and more slots need no migration.
model Character {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId           String       @map("profile_id") @db.Uuid
  slot                Int          @db.SmallInt
  name                String       @db.VarChar(24)
  level               Int          @default(1)
  /// Stage progress (ADR-020). Stages are effectively unlimited, hence bigint.
  /// The stage the next combat is fought on — pushed or farmed.
  currentStage        BigInt       @default(1) @map("current_stage")
  /// The highest stage ever unlocked. Never decreases.
  highestStageReached BigInt       @default(1) @map("highest_stage_reached")
  /// The highest stage ever defeated; NULL until the first clear. Never decreases.
  highestStageCleared BigInt?      @map("highest_stage_cleared")
  /// What a victory does to `current_stage` (ADR-021): climb on, or stay and farm.
  stageMode           StageMode    @default(PROGRESS) @map("stage_mode")
  /// Experience within the current level (HugeNumber pair).
  experienceCoef      BigInt       @default(0) @map("experience_coef")
  experienceExp       Int          @default(-2147483648) @map("experience_exp")
  /// Gold (HugeNumber pair).
  goldCoef            BigInt       @default(0) @map("gold_coef")
  goldExp             Int          @default(-2147483648) @map("gold_exp")
  /// Server time before which the character is still fighting its last combat.
  /// Also the processed boundary of offline progression (ADR-023): every
  /// instant before it is accounted for, by a fight online or offline.
  nextCombatAt        DateTime     @default(now()) @map("next_combat_at") @db.Timestamptz(3)
  /// Server-held seed of the next offline claim (ADR-023). Never sent to a
  /// client; replaced by a fresh CSPRNG seed on every committed claim, so the
  /// fights of a claim cannot be re-rolled by asking again.
  offlineSeed         String       @default(dbgenerated("(replace((gen_random_uuid())::text, '-'::text, ''::text) || replace((gen_random_uuid())::text, '-'::text, ''::text))")) @map("offline_seed") @db.VarChar(64)
  /// Optimistic concurrency token: every progression write increments it.
  version             BigInt       @default(0)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile             Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  combatRuns          CombatRun[]
  offlineRuns         OfflineRun[]
  itemInstances       ItemInstance[]
  equipment           CharacterEquipment[]

  @@unique([profileId, slot], map: "characters_profile_id_slot_key")
  @@map("characters")
}

model ItemInstance {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId  String               @map("character_id") @db.Uuid
  definitionId String               @map("definition_id") @db.VarChar(64)
  rarity       String               @db.VarChar(16)
  generationVersion Int             @default(0) @map("generation_version")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The authoritative online combat reward that minted this item, if any.
  combatRunId  String?              @unique(map: "item_instances_combat_run_id_key") @map("combat_run_id") @db.Uuid
  character    Character            @relation(fields: [characterId], references: [id], onDelete: Cascade)
  combatRun    CombatRun?           @relation(fields: [combatRunId, characterId], references: [id, characterId], onDelete: Cascade, map: "item_instances_combat_reward_owner_fkey")
  equippedAs   CharacterEquipment?
  affixes      ItemAffixRoll[]

  @@unique([id, characterId], map: "item_instances_id_character_id_key")
  @@unique([combatRunId, characterId], map: "item_instances_combat_run_character_key")
  @@index([characterId, createdAt, id], map: "item_instances_inventory_order_idx")
  @@map("item_instances")
}

model ItemAffixRoll {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemInstanceId    String       @map("item_instance_id") @db.Uuid
  affixDefinitionId String       @map("affix_definition_id") @db.VarChar(64)
  stat              String       @db.VarChar(32)
  operation         String       @db.VarChar(24)
  value             String       @db.VarChar(64)
  generationVersion Int          @map("generation_version")
  position          Int          @db.SmallInt
  itemInstance      ItemInstance @relation(fields: [itemInstanceId], references: [id], onDelete: Cascade)

  @@unique([itemInstanceId, position], map: "item_affix_rolls_item_position_key")
  @@unique([itemInstanceId, affixDefinitionId], map: "item_affix_rolls_item_definition_key")
  @@index([itemInstanceId, position], map: "item_affix_rolls_order_idx")
  @@map("item_affix_rolls")
}

model CharacterEquipment {
  characterId   String       @map("character_id") @db.Uuid
  slot          String       @db.VarChar(16)
  itemInstanceId String      @unique(map: "character_equipment_item_instance_id_key") @map("item_instance_id") @db.Uuid
  character     Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  itemInstance  ItemInstance @relation(fields: [itemInstanceId, characterId], references: [id, characterId], onDelete: Cascade, map: "character_equipment_item_owner_fkey")

  @@id([characterId, slot])
  @@unique([itemInstanceId, characterId], map: "character_equipment_item_character_key")
  @@map("character_equipment")
}

// What a victory does to the current stage (ADR-021). PROGRESS climbs on to
// the next stage (and falls back on a defeat); FARM stays on the stage.
enum StageMode {
  PROGRESS
  FARM

  @@map("stage_mode")
}

enum CombatOutcome {
  WIN
  LOSS

  @@map("combat_outcome")
}

enum CombatEndReason {
  ENEMY_DEFEATED
  PLAYER_DEFEATED
  TIME_LIMIT

  @@map("combat_end_reason")
}

// One resolved combat: the replay inputs and the audited result (ADR-019).
//
// The event log is not stored. `resolveStageAttempt(inputs, seed,
// rules_version)` regenerates it exactly. The summary columns record what was
// granted and why, which makes this table the ledger of every gold and
// experience gain.
//
// `(character_id, idempotency_key)` is unique: a retried request finds the
// combat it already produced instead of fighting again.
model CombatRun {
  id                        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId               String          @map("character_id") @db.Uuid
  /// Client-generated per fight intent. Carries no gameplay input.
  idempotencyKey            String          @map("idempotency_key") @db.Uuid
  /// GAME_RULES_VERSION the combat was resolved under (docs/DATABASE.md).
  rulesVersion              Int             @map("rules_version")
  /// Server CSPRNG seed. Never chosen by or sent to the client.
  seed                      String          @db.VarChar(64)
  // Progression before the combat: the replay input. `stage` is the stage
  // actually fought (the current stage then), whatever the character moved to.
  stage                     BigInt
  highestStageReachedBefore BigInt          @map("highest_stage_reached_before")
  highestStageClearedBefore BigInt?         @map("highest_stage_cleared_before")
  /// The character's stage mode when it fought (ADR-021): a replay input.
  stageMode                 StageMode       @map("stage_mode")
  characterLevel            Int             @map("character_level")
  experienceBeforeCoef      BigInt          @map("experience_before_coef")
  experienceBeforeExp       Int             @map("experience_before_exp")
  goldBeforeCoef            BigInt          @map("gold_before_coef")
  goldBeforeExp             Int             @map("gold_before_exp")
  // Summary of the result: the audit record.
  outcome                   CombatOutcome
  endReason                 CombatEndReason @map("end_reason")
  durationMs                Int             @map("duration_ms")
  rewardGoldCoef            BigInt          @map("reward_gold_coef")
  rewardGoldExp             Int             @map("reward_gold_exp")
  rewardExperienceCoef      BigInt          @map("reward_experience_coef")
  rewardExperienceExp       Int             @map("reward_experience_exp")
  /// Server time the combat was resolved and committed.
  createdAt                 DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  character                 Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  awardedItem               ItemInstance?

  @@unique([characterId, idempotencyKey], map: "combat_runs_character_id_idempotency_key_key")
  @@unique([id, characterId], map: "combat_runs_id_character_id_key")
  @@map("combat_runs")
}

// One offline claim that fought (ADR-023): the replay inputs and the audited
// summary of every fight in it. Claims that fight nothing write no row.
//
// Offline fights are not written to `combat_runs` one by one: an 8-hour claim
// holds up to 28 800 of them. `resolveOfflineProgress(inputs, seed,
// rules_version)` regenerates each fight exactly, and the summary columns are
// the ledger entry for the gold and experience the claim granted.
//
// `(character_id, idempotency_key)` is unique: a retried claim finds the
// result it already produced instead of claiming again.
model OfflineRun {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId          String    @map("character_id") @db.Uuid
  /// Client-generated per claim intent. Carries no gameplay input.
  idempotencyKey       String    @map("idempotency_key") @db.Uuid
  /// GAME_RULES_VERSION the claim was resolved under.
  rulesVersion         Int       @map("rules_version")
  /// Server seed of the claim. Never chosen by or sent to the client.
  seed                 String    @db.VarChar(64)
  // Time, all server clock. Idle time ran from `idle_since` (the processed
  // boundary before the claim) to `created_at` (the claim). Fights filled
  // `rewarded_from` … `processed_until`, the new boundary.
  idleSince            DateTime  @map("idle_since") @db.Timestamptz(3)
  rewardedFrom         DateTime  @map("rewarded_from") @db.Timestamptz(3)
  processedUntil       DateTime  @map("processed_until") @db.Timestamptz(3)
  // Progression at the claim: the replay input. The stage progress is the
  // same after it; offline fights never move a stage or a record.
  currentStage         BigInt    @map("current_stage")
  highestStageReached  BigInt    @map("highest_stage_reached")
  highestStageCleared  BigInt    @map("highest_stage_cleared")
  characterLevel       Int       @map("character_level")
  experienceBeforeCoef BigInt    @map("experience_before_coef")
  experienceBeforeExp  Int       @map("experience_before_exp")
  goldBeforeCoef       BigInt    @map("gold_before_coef")
  goldBeforeExp        Int       @map("gold_before_exp")
  // Summary of the result: the audit record.
  /// The stage farmed: always a stage already cleared.
  targetStage          BigInt    @map("target_stage")
  fights               Int
  wins                 Int
  losses               Int
  levelsGained         Int       @map("levels_gained")
  rewardGoldCoef       BigInt    @map("reward_gold_coef")
  rewardGoldExp        Int       @map("reward_gold_exp")
  rewardExperienceCoef BigInt    @map("reward_experience_coef")
  rewardExperienceExp  Int       @map("reward_experience_exp")
  /// Server time of the claim: the end of the idle time it counted.
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  character            Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, idempotencyKey], map: "offline_runs_character_id_idempotency_key_key")
  @@map("offline_runs")
}
